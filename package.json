{
  "name": "rocky-project",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "rocky-project": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/run-dev-stack.mjs",
    "agent": "npm run build --silent && node dist/src/cli.js",
    "install:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "start:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-rocky-windows.ps1",
    "stop:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-rocky-windows.ps1",
    "uninstall:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-release.ps1",
    "release:windows:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-installer.ps1",
    "release:macos": "node scripts/package-macos-release.mjs",
    "test": "npm run build --silent && node --test dist/test/agents/*.test.js dist/test/api/*.test.js dist/test/runtime/*.test.js dist/test/web/*.test.js",
    "test:e2e": "npm run build --silent && node --test dist/test/api/cli-http-workflow.e2e.test.js",
    "test:e2e:live": "npm run build --silent && node dist/scripts/live-e2e.js",
    "runtime:probe": "bash scripts/runtime-capability-probe.sh",
    "benchmark:latency": "npm run build --silent && node dist/scripts/session-latency-benchmark.js",
    "benchmark:interactive-kept-open": "npm run build --silent && node dist/scripts/interactive-kept-open-vs-service.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "smoke": "npm run build --silent && node dist/scripts/manual-smoke.js",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:test:e2e": "npm --prefix web run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fastify": "^5.8.5",
    "playwright": "^1.59.1"
  }
}
